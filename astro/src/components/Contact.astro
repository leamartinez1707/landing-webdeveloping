---
import { site, socials } from "../data/site.js";
---

<section id="contacto" class="border-b border-ink/10 py-20 md:py-28">
  <div class="container-measure grid gap-12 lg:grid-cols-[0.9fr_1.1fr]">
    <div>
      <p class="eyebrow">05 contacto</p>
      <h2 class="mt-4 text-[clamp(2rem,4vw,3rem)]">¿Hablamos de tu negocio?</h2>
      <p class="prose-measure mt-4 text-lg text-slate">
        Contame qué necesita tu negocio y vemos juntos si una landing, un sitio, un software a
        medida o una automatización te lo resuelve.
      </p>

      <a
        href={site.whatsapp}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-6 inline-flex items-center justify-center rounded-sm bg-signal px-6 py-3 text-sm font-semibold text-paper transition-opacity hover:opacity-90"
      >
        Escribime por WhatsApp
      </a>

      <div class="mt-8 border border-ink/15 bg-paper-deep/50 p-6">
        <p class="font-mono text-xs uppercase tracking-[0.1em] text-slate">Canales directos</p>
        <ul class="mt-4 space-y-2 text-sm text-slate">
          <li>Email: {site.email}</li>
          <li>Teléfono: {site.phone}</li>
          <li>Horario: lunes a viernes, 09:00 - 18:00 UY</li>
        </ul>
      </div>

      <div class="mt-9 border-t border-ink/10 pt-8">
        <p class="mb-4 font-mono text-xs uppercase tracking-[0.1em] text-slate">
          También podés escribirme por
        </p>
        <div class="flex gap-3">
          {
            socials.map((item) => (
              <a
                href={item.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={item.label}
                class="border border-ink/15 px-4 py-2 font-mono text-xs uppercase tracking-[0.04em] text-slate hover:border-signal hover:text-signal"
              >
                {item.label}
              </a>
            ))
          }
        </div>
      </div>
    </div>

    <div>
      <p class="mb-3 font-mono text-xs uppercase tracking-[0.1em] text-slate">o dejá tu consulta acá</p>
      <form id="contact-form" novalidate class="border border-ink/15 bg-paper-deep/40 p-7">
      <div class="grid gap-1.5">
        <label for="name" class="text-sm font-semibold">Nombre</label>
        <input
          id="name"
          name="name"
          type="text"
          placeholder="Ejemplo: Lucía Fernández"
          class="border border-ink/20 bg-paper px-4 py-3 text-sm"
        />
        <p data-error-for="name" class="hidden text-sm text-red-700"></p>
      </div>

      <div class="mt-4 grid gap-1.5">
        <label for="email" class="text-sm font-semibold">Email</label>
        <input
          id="email"
          name="email"
          type="email"
          placeholder="tuemail@empresa.com"
          class="border border-ink/20 bg-paper px-4 py-3 text-sm"
        />
        <p data-error-for="email" class="hidden text-sm text-red-700"></p>
      </div>

      <div class="mt-4 grid gap-1.5">
        <label for="service" class="text-sm font-semibold">Tipo de proyecto</label>
        <select id="service" name="service" class="border border-ink/20 bg-paper px-4 py-3 text-sm">
          <option value="">Selecciona una opción</option>
          <option value="Página web básica">Página web básica</option>
          <option value="Página web completa">Página web completa</option>
          <option value="Tienda online Shopify">Tienda online Shopify</option>
          <option value="Automatización">Automatización</option>
          <option value="Software a medida">Software a medida</option>
          <option value="No estoy seguro">No estoy seguro</option>
        </select>
        <p data-error-for="service" class="hidden text-sm text-red-700"></p>
      </div>

      <div class="mt-4 grid gap-1.5">
        <label for="budget" class="text-sm font-semibold">Presupuesto estimado (opcional)</label>
        <select id="budget" name="budget" class="border border-ink/20 bg-paper px-4 py-3 text-sm">
          <option value="">Prefiero definirlo en llamada</option>
          <option value="USD 190 - 500">USD 190 - 500</option>
          <option value="USD 500 - 1.500">USD 500 - 1.500</option>
          <option value="A cotizar">A cotizar (software a medida / proyecto grande)</option>
        </select>
      </div>

      <div class="mt-4 grid gap-1.5">
        <label for="message" class="text-sm font-semibold">Necesidad principal</label>
        <textarea
          id="message"
          name="message"
          rows="5"
          placeholder="Contame objetivos, plazos y contexto de tu negocio"
          class="resize-none border border-ink/20 bg-paper px-4 py-3 text-sm"></textarea>
        <p data-error-for="message" class="hidden text-sm text-red-700"></p>
      </div>

      <button
        type="submit"
        class="mt-6 w-full rounded-sm bg-signal px-5 py-3 text-sm font-semibold text-paper transition-opacity hover:opacity-90 disabled:cursor-not-allowed disabled:opacity-60"
      >
        Enviar consulta
      </button>

      <p id="form-status" class="mt-3 hidden text-sm font-medium" role="status"></p>
    </form>
    </div>
  </div>
</section>

<script>
  import emailjs from "@emailjs/browser";

  const form = document.getElementById("contact-form");
  const statusEl = document.getElementById("form-status");
  const submitButton = form?.querySelector('button[type="submit"]');

  const setError = (field, message) => {
    const el = form?.querySelector(`[data-error-for="${field}"]`);
    if (!el) return;
    el.textContent = message || "";
    el.classList.toggle("hidden", !message);
  };

  const validate = (data) => {
    const errors = {};

    if (!data.name || data.name.trim().length < 2) {
      errors.name = "Escribí un nombre válido.";
    }
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(data.email || "")) {
      errors.email = "Ingresá un email válido.";
    }
    if (!data.service) {
      errors.service = "Seleccioná el tipo de proyecto.";
    }
    if (!data.message || data.message.trim().length < 20) {
      errors.message = "Contame un poco más. Mínimo 20 caracteres.";
    }

    return errors;
  };

  const setStatus = (type, message) => {
    if (!statusEl) return;
    statusEl.textContent = message;
    statusEl.classList.remove("hidden", "text-red-700", "text-signal");
    statusEl.classList.add(type === "error" ? "text-red-700" : "text-signal");
  };

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    ["name", "email", "service", "message"].forEach((field) => setError(field, ""));

    const formData = new FormData(form);
    const data = Object.fromEntries(formData.entries());
    const errors = validate(data);

    if (Object.keys(errors).length > 0) {
      Object.entries(errors).forEach(([field, message]) => setError(field, message));
      return;
    }

    const serviceId = import.meta.env.PUBLIC_EMAILJS_SERVICE_ID;
    const templateId = import.meta.env.PUBLIC_EMAILJS_TEMPLATE_ID;
    const publicKey = import.meta.env.PUBLIC_EMAILJS_PUBLIC_KEY;

    if (!serviceId || !templateId || !publicKey) {
      setStatus("error", "El formulario no está configurado en este entorno.");
      return;
    }

    submitButton?.setAttribute("disabled", "true");
    setStatus("idle", "Enviando mensaje...");

    try {
      await emailjs.send(
        serviceId,
        templateId,
        {
          name: data.name,
          email: data.email,
          service: data.service,
          budget: data.budget || "No especificado",
          message: data.message,
          date: new Date().toISOString().split("T")[0],
        },
        publicKey
      );

      setStatus("success", "Mensaje enviado. Te responderé dentro de las próximas 24 horas.");
      form.reset();
    } catch {
      setStatus(
        "error",
        "No se pudo enviar el formulario. Escribime por WhatsApp para una respuesta inmediata."
      );
    } finally {
      submitButton?.removeAttribute("disabled");
    }
  });
</script>

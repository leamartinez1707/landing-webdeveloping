---
import { site } from "../data/site.js";
---

<a
  id="whatsapp-sticky"
  href={site.whatsapp}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Escribir por WhatsApp"
  class="fixed bottom-5 right-5 z-30 inline-flex items-center gap-2 rounded-sm bg-signal px-4 py-3 text-sm font-semibold text-paper shadow-[0_10px_25px_rgba(22,24,29,0.25)] transition-all duration-300"
>
  <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
    <path
      d="M12.02 2c-5.5 0-9.96 4.46-9.96 9.96 0 1.76.46 3.48 1.34 5L2 22l5.2-1.36a9.94 9.94 0 0 0 4.82 1.23h.01c5.5 0 9.96-4.46 9.96-9.96S17.53 2 12.02 2Zm5.84 14.2c-.25.7-1.45 1.34-2 1.42-.51.08-1.16.11-1.87-.12-.43-.14-.98-.32-1.68-.62-2.96-1.28-4.89-4.25-5.04-4.45-.15-.2-1.21-1.6-1.21-3.06 0-1.45.77-2.17 1.04-2.47.27-.3.6-.37.8-.37.2 0 .4 0 .57.01.18.01.43-.07.67.51.25.6.85 2.07.92 2.22.07.15.12.33.02.53-.1.2-.15.32-.3.5-.15.17-.31.38-.44.51-.15.15-.3.31-.13.6.17.3.76 1.25 1.63 2.02 1.12 1 2.06 1.31 2.36 1.46.3.15.47.13.65-.08.17-.2.73-.85.93-1.15.2-.3.4-.24.66-.15.27.1 1.73.82 2.03.97.3.15.5.22.57.35.08.13.08.75-.17 1.45Z"
    ></path>
  </svg>
  WhatsApp
</a>

<script>
  const button = document.getElementById("whatsapp-sticky");
  const footer = document.querySelector("footer");

  if (button && footer) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          button.classList.toggle("opacity-0", entry.isIntersecting);
          button.classList.toggle("pointer-events-none", entry.isIntersecting);
        });
      },
      { rootMargin: "0px 0px -10% 0px" }
    );

    observer.observe(footer);
  }
</script>

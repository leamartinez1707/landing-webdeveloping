---
import { Image } from "astro:assets";
import { portfolio } from "../data/site.js";
import todomuebles from "../assets/projects/todomuebles.webp";
import mistyle from "../assets/projects/mistyle.webp";
import urufix from "../assets/projects/urufix.webp";

const images = { todomuebles, mistyle, urufix };
---

<section id="proyectos" class="border-b border-ink/10 py-20 md:py-28">
  <div class="container-measure">
    <div class="prose-measure">
      <p class="eyebrow">04 portfolio</p>
      <h2 class="mt-4 text-[clamp(2rem,4vw,3rem)]">
        Resultados visibles en negocios de distintos rubros
      </h2>
      <p class="mt-4 text-lg text-slate">
        Estos proyectos reflejan el tipo de trabajo que hago: objetivos concretos, decisiones de
        UX claras y ejecución técnica sin ruido.
      </p>
    </div>

    <ul class="mt-14 divide-y divide-ink/10 border-y border-ink/10">
      {
        portfolio.map((project) => {
          const hasLink = project.link !== "#";
          const hasImage = Boolean(images[project.slug]);
          const Wrapper = hasLink ? "a" : "div";

          return (
            <li class="py-8">
              <Wrapper
                {...(hasLink
                  ? { href: project.link, target: "_blank", rel: "noopener noreferrer" }
                  : {})}
                class="group grid gap-5 sm:grid-cols-[220px_1fr] sm:items-start sm:gap-8"
              >
                {hasImage && (
                  <div class="overflow-hidden border border-ink/10">
                    <Image
                      src={images[project.slug]}
                      alt={`${project.type}: ${project.title}. ${project.description}`}
                      width={640}
                      height={480}
                      loading="lazy"
                      class="aspect-[4/3] h-auto w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
                    />
                  </div>
                )}

                <div class={hasImage ? "" : "sm:col-span-2"}>
                  <span class="font-mono text-xs uppercase tracking-[0.06em] text-signal">
                    {project.type}
                  </span>
                  <h3 class="mt-1 text-2xl leading-tight md:text-3xl">{project.title}</h3>
                  {hasLink && (
                    <span class="mt-1 block font-mono text-xs text-slate">Ver proyecto →</span>
                  )}
                  <p class="prose-measure mt-3 text-sm text-slate">{project.description}</p>
                  <p class="font-mono text-xs text-ink mt-3">{project.result}</p>
                </div>
              </Wrapper>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

---
import { site } from "../data/site.js";

const year = new Date().getFullYear();
---

<footer class="bg-ink py-12 text-paper">
  <div class="container-measure grid gap-8 md:grid-cols-3 md:items-end">
    <div>
      <p class="font-display text-xl">{site.name}</p>
      <p class="mt-2 text-sm text-paper/70">
        Páginas web, software a medida y automatizaciones para negocios que buscan crecer con claridad.
      </p>
    </div>

    <nav class="flex flex-wrap gap-4 font-mono text-xs uppercase tracking-[0.04em] text-paper/80">
      <a href="#inicio" class="hover:text-paper">Inicio</a>
      <a href="#servicios" class="hover:text-paper">Servicios</a>
      <a href="#proyectos" class="hover:text-paper">Proyectos</a>
      <a href="#contacto" class="hover:text-paper">Contacto</a>
      <a href="/privacy" class="hover:text-paper">Privacidad</a>
      <a href="/terms" class="hover:text-paper">Términos</a>
    </nav>

    <div class="md:text-right">
      <p class="font-mono text-sm text-paper/70">$ contacto --iniciar</p>
      <p class="mt-3 text-xs text-paper/50">&copy; {year} {site.name}</p>
    </div>
  </div>
</footer>
